COMPOSE_PROJECT_NAME=tts
# Thesis service images built by the CI of akkbng/opentelemetry-astronomy-shop (fork of opentelemetry-demo, base
# upstream commit 8653756) - linux/amd64 only, run under emulation on arm64 hosts. Digests are pinned in docker-compose.yml.
IMAGE_NAME=ghcr.io/akkbng/opentelemetry-astronomy-shop
COLLECTOR_IMAGE=otel-transparency-collector:dev
CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.108.0
# Where the services send telemetry: otelcol (demo profile) or fanout (experiment profile)
OTEL_COLLECTOR_HOST=otelcol
# TILT document used by the demo collector (relative to deploy/)
TILT_FILE=../tilt/tilt.thesis.json
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1
